# Figma OAuth app (https://www.figma.com/developers/apps).
# Callback URL to register on the app: https://sites-figma.deco.site/oauth/callback
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=

# Seals the OAuth state and code (which carries the Figma token). Required:
# the server refuses to start without it. Generate: openssl rand -hex 32
OAUTH_STATE_SECRET=

# Optional, comma-separated: extra Mesh/Studio hosts allowed as OAuth redirect
# targets besides decocms.com (self-hosted installs, e.g. localhost for dev).
EXTRA_ALLOWED_REDIRECT_HOSTS=
