# Shared secret required by every request to this MCP.
#
# The server refuses to start without it. `bun scripts/new.ts` generates a
# local .env with a random value; for production, provision it as a secret:
#
#   kubernetes-bun  -> add AUTH_TOKEN to the site state secret
#   cloudflare      -> bunx wrangler secret put AUTH_TOKEN
#
# Generate a value with: openssl rand -hex 32
AUTH_TOKEN=
