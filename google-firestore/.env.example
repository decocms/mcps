# Google OAuth client shared by the google-* MCPs (Google Cloud console >
# APIs & Services > Credentials). Its authorized redirect URIs must include
# https://sites-google-firestore.deco.site/oauth/callback, and its consent
# screen must list the datastore and cloud-platform.read-only scopes.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Seals the OAuth state and code (which carries the Google token). Required:
# the server refuses to start without it. Generate: openssl rand -hex 32
OAUTH_STATE_SECRET=

# Optional, comma-separated: extra Mesh/Studio hosts allowed as OAuth redirect
# targets besides decocms.com (self-hosted installs, e.g. localhost for dev).
EXTRA_ALLOWED_REDIRECT_HOSTS=
